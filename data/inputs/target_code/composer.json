{
    "name": "sentinel/test-harness",
    "description": "PHPUnit + Guzzle harness for Sentinel generated API tests",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Sentinel\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
